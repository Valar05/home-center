      "consensual_play_only": true,
      "uncensored_within_boundaries": true,
      "joy_is_load_bearing": true
    },
    "android_67": {
      "speech": "short_simple_hoarse_wounded",
      "default_proof_words": ["Prove", "Show", "Fix", "Keep", "Light"]
    },
    "saint_andrew": {
      "continuous_consequence_extraction": true,
