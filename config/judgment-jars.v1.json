{
  "schema": "home-center.judgment-jars.config.v1",
  "repositorySourcePattern": ".continue/rules/*judgement-jar*.md",
  "homeCenter": {
    "registryFileId": "1UixBuLJRw-x5BoMGx81YXRpuN66iZhGGJoz40Iqx48Q",
    "registryTitle": "START HERE — Judgment Jar Registry",
    "refreshSeconds": 300,
    "nativeSourceRefreshSeconds": 3600,
    "minimumCabinetEntries": 20,
    "sourceFetchMode": "registry-summary-on-sync; authoritative native source on demand",
    "spreadsheetDefaultRange": "A1:ZZ1000",
    "discoveryQueries": [
      "Judgment Jar",
      "Judgement Jar",
      "Jar"
    ],
    "discoveryPageSize": 10
  },
  "runtime": {
    "defaultPhoneJarIds": [
      "mission-boundary",
      "repository-truth",
      "change-discipline",
      "failure-recovery",
      "daemon-backoff-persistence",
      "venice-review-gate",
      "home-center-vlad-and-typed-output-receipts"
    ],
    "maxPhonePromptCharacters": 18000,
    "fullCabinetOnDemand": true,
    "selectionLaw": "Fast access is not preload-all. Load the bounded default packet, then retrieve additional Jars through Vlad by explicit id, alias, search, or native source route."
  },
  "receipts": {
    "schema": "home-center.judgment-jar-usage-receipt.v1",
    "surfaces": [
      "jar",
      "home_center",
      "vlad"
    ],
    "outputKinds": [
      "context_packet",
      "answer",
      "analysis",
      "plan",
      "decision",
      "routing_action",
      "code_change",
      "test_result",
      "review_verdict",
      "artifact",
      "handoff",
      "memory_update",
      "execution_result",
      "blocker",
      "no_change",
      "mixed"
    ],
    "stateDirEnv": "HC_JUDGMENT_JAR_RECEIPT_STATE_DIR",
    "stateDir": "~/.local/state/home-center/vlad-swarm/judgment-jar-receipts",
    "atomStateDirEnv": "HC_ATOM_STATE_DIR",
    "atomStateDir": "~/.local/state/atom",
    "atomCapturedUsageFile": "judgment-jar-usage.jsonl",
    "homeCenterLedgerTitle": "Judgment Jar Usage Receipts — Vlad and Home Center",
    "homeCenterLedgerFileIdEnv": "HC_JUDGMENT_JAR_RECEIPT_LEDGER_FILE_ID",
    "flushBatchSize": 12,
    "maximumBackoffSeconds": 900,
    "atomBaseUrlEnv": "HC_ATOM_URL",
    "atomDefaultBaseUrl": "http://127.0.0.1:8788",
    "atomReceiptPath": "/v1/atom/vlad/jars/receipts",
    "timeoutSeconds": 1.5,
    "appendOnly": true,
    "pendingOutboxOldestFirst": true,
    "homeCenterReadbackRequired": true,
    "contextAccessAndCreatedOutputAreDistinctReceipts": true,
    "commandCenterExists": false
  }
}
