{
  "manifest_version": 3,
  "name": "Chromium Throne",
  "version": "0.7.0",
  "description": "One visible persistent ChatGPT Pro campaign worker for Fortress interface evolution, with durable context, Venice/Judgment Jar continuation, She-Raw motivational review pressure, and the existing Atom/Vlad relay seam.",
  "key": "",
  "permissions": ["activeTab", "tabs", "scripting", "sidePanel", "storage", "alarms"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1:9234/*"],
  "action": {"default_title": "Open Chromium Throne"},
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "side_panel": {"default_path": "sidepanel.html"}
}
