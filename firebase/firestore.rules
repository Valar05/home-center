rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(bucketId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(bucketId)/members/$(request.auth.uid));
    }

    function isGroupMember(bucketId, groupId) {
      return isMember(bucketId)
        && groupId is string
        && groupId.size() > 0
        && exists(/databases/$(database)/documents/households/$(bucketId)/groups/$(groupId)/members/$(request.auth.uid));
    }

    function listVisibleData(bucketId, list) {
      return list.visibility == null
        || list.visibility == "household"
        || (list.visibility == "personal" && list.ownerUid == request.auth.uid)
        || (list.visibility == "group" && isGroupMember(bucketId, list.groupId));
    }

    function listVisible(bucketId, listId) {
      return isMember(bucketId)
        && exists(/databases/$(database)/documents/households/$(bucketId)/lists/$(listId))
        && listVisibleData(bucketId, get(/databases/$(database)/documents/households/$(bucketId)/lists/$(listId)).data);
    }

    function validListWrite(bucketId) {
      return isMember(bucketId)
        && (
          request.resource.data.visibility == null
          || request.resource.data.visibility == "household"
          || (request.resource.data.visibility == "personal" && request.resource.data.ownerUid == request.auth.uid)
          || (request.resource.data.visibility == "group" && isGroupMember(bucketId, request.resource.data.groupId))
        );
    }

    match /households/{bucketId} {
      allow create: if signedIn();
      allow read, update: if isMember(bucketId);
      allow delete: if false;

      match /members/{uid} {
        allow create, update: if signedIn() && uid == request.auth.uid;
        allow read: if isMember(bucketId);
        allow delete: if false;
      }

      match /groups/{groupId} {
        allow create, update: if isMember(bucketId);
        allow read: if isGroupMember(bucketId, groupId);
        allow delete: if false;

        match /members/{uid} {
          allow create, update: if isMember(bucketId) && uid == request.auth.uid;
          allow read: if isGroupMember(bucketId, groupId);
          allow delete: if false;
        }
      }

      match /lists/{listId} {
        allow create: if validListWrite(bucketId);
        allow read: if isMember(bucketId) && listVisibleData(bucketId, resource.data);
        allow update: if validListWrite(bucketId)
          && (
            listVisibleData(bucketId, resource.data)
            || request.resource.data.visibility == "household"
            || (request.resource.data.visibility == "personal" && request.resource.data.ownerUid == request.auth.uid)
          );
        allow delete: if false;

        match /tasks/{taskId} {
          allow read, create, update: if isMember(bucketId)
            && exists(/databases/$(database)/documents/households/$(bucketId)/lists/$(listId));
          allow delete: if false;
        }
      }

      match /smsCalendarIntake/{messageId} {
        allow create: if isMember(bucketId)
          && request.resource.data.schemaVersion == "home-center.sms-calendar-intake.v2"
          && request.resource.data.messageId == messageId
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.status == "received"
          && request.resource.data.privacyScope == "sms_calendar_private"
          && request.resource.data.source.type == "android_notification"
          && request.resource.data.source.transport == "android_google_messages_notification"
          && request.resource.data.source.packageName == "com.google.android.apps.messaging"
          && request.resource.data.sourceTransport == "android_google_messages_notification"
          && request.resource.data.sourceHash == request.resource.data.immutableHash
          && request.resource.data.ingestionIdempotencyKey is string
          && request.resource.data.ingestionIdempotencyKey.size() > 16
          && request.resource.data.recipientDeviceId is string
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 12000;
        allow read: if isMember(bucketId)
          && resource.data.createdByUid == request.auth.uid;
        allow update: if isMember(bucketId)
          && resource.data.createdByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "classification", "proposal", "status", "classifiedAtMs", "updatedAtMs"
          ])
          && request.resource.data.status in ["classified", "proposal_ready"]
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.messageId == resource.data.messageId
          && request.resource.data.sender == resource.data.sender
          && request.resource.data.senderAddress == resource.data.senderAddress
          && request.resource.data.recipientDeviceId == resource.data.recipientDeviceId
          && request.resource.data.body == resource.data.body
          && request.resource.data.receivedAtMs == resource.data.receivedAtMs
          && request.resource.data.sourceTransport == resource.data.sourceTransport
          && request.resource.data.sourceHash == resource.data.sourceHash
          && request.resource.data.immutableHash == resource.data.immutableHash
          && request.resource.data.ingestionIdempotencyKey == resource.data.ingestionIdempotencyKey
          && request.resource.data.source == resource.data.source
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.createdAtMs == resource.data.createdAtMs
          && request.resource.data.preservedAtMs == resource.data.preservedAtMs
          && request.resource.data.privacyScope == resource.data.privacyScope;
        allow delete: if false;
      }
    }
  }
}
