{
  "projectId": "tanks-for-the-memories",
  "version": "2026-07-10-termux-v1",
  "workerId": "termux-tanks-oneshot",
  "location": "termux",
  "repoPath": "/storage/emulated/0/Documents/GodotProjects/tanks-for-the-memories",
  "baseWorkspaceId": "tanks-for-the-memories-termux-base",
  "capabilities": [
    "codex",
    "one-shot-worker",
    "prepared-workspace",
    "github",
    "node",
    "python",
    "proot-debian",
    "blender",
    "cloud-visual-truth",
    "gh-pages"
  ],
  "limits": {
    "concurrentJobs": 1
  },
  "defaultExecutorCommand": "sh /storage/emulated/0/Documents/GodotProjects/home-center/tools/command_center_codex_executor.sh",
  "orientationFiles": [
    "PROJECT_ORIENTATION.md",
    "REPO_DOCTRINE.md",
    "docs/doctrine/cloud-visual-truth.md",
    "docs/doctrine/sherman-hard-model-texture-architecture.md",
    "docs/doctrine/3d-placement-corpus.md"
  ],
  "toolChecks": [
    {
      "name": "git",
      "command": "git --version"
    },
    {
      "name": "gh",
      "command": "gh --version"
    },
    {
      "name": "node",
      "command": "node --version"
    },
    {
      "name": "python3",
      "command": "python3 --version"
    },
    {
      "name": "proot-distro",
      "command": "proot-distro --help"
    },
    {
      "name": "debian-blender",
      "command": "proot-distro list 2>&1 | grep -q 'debian'",
      "optional": true,
      "deepCommand": "proot-distro login debian -- blender --background --version"
    },
    {
      "name": "npm-scripts",
      "command": "node -e \"const p=require('./package.json'); console.log(Object.keys(p.scripts||{}).join(','))\""
    }
  ],
  "verificationCommands": [
    "npm run build",
    "npm test"
  ],
  "mutationDefaults": {
    "editFiles": "allowed",
    "runTests": "allowed",
    "commit": "allowed",
    "createIssue": "allowed",
    "createPullRequest": "allowed",
    "push": "confirm",
    "deployPreview": "confirm",
    "merge": "confirm",
    "destructive": "deny"
  },
  "notes": [
    "Visual acceptance for tank/browser/model work is cloud-gated; local screenshots are diagnostic only.",
    "Blender authoring for this project runs through Debian proot, not host blender.",
    "The base workspace is the existing local repo; ordinary one-shot execution copies it into a disposable overlay."
  ]
}
