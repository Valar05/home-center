{
  "projectId": "pose-lab-v2",
  "version": "2026-07-11-termux-v1",
  "workerId": "termux-pose-lab-v2-oneshot",
  "location": "termux",
  "repoPath": "/storage/emulated/0/Documents/GodotProjects/pose-lab-v2",
  "baseWorkspaceId": "pose-lab-v2-termux-base",
  "capabilities": [
    "codex",
    "one-shot-worker",
    "prepared-workspace",
    "github",
    "node",
    "python",
    "proot-debian",
    "blender",
    "gh-pages"
  ],
  "limits": {
    "concurrentJobs": 1
  },
  "orientationFiles": [
    "CODEX_STARTS_HERE.md",
    "PROJECT_ORIENTATION.md",
    "README.md",
    "docs/VISUAL_VERIFICATION_DOCTRINE.md",
    "docs/POSE_LAB_V2_ATTACK_BAKE_DOCTRINE.md",
    "docs/LOCAL_BLENDER_ANIMATION_MUSCLE.md",
    "docs/CLOUD_WORKER_ANIMATION_SURFACE.md",
    "docs/CLOUD_WORKER_OUTPUT_CONTRACT.md",
    "docs/COMMAND_CENTER_DISPATCH_PROMPT.md"
  ],
  "toolChecks": [
    {
      "name": "git",
      "command": "git --version"
    },
    {
      "name": "gh",
      "command": "gh --version"
    },
    {
      "name": "node",
      "command": "node --version"
    },
    {
      "name": "python3",
      "command": "python3 --version"
    },
    {
      "name": "proot-distro",
      "command": "proot-distro --help",
      "optional": true
    },
    {
      "name": "debian-blender",
      "command": "proot-distro list 2>&1 | grep -q 'debian'",
      "optional": true,
      "deepCommand": "proot-distro login debian -- blender --background --version"
    },
    {
      "name": "npm-scripts",
      "command": "node -e \"const p=require('./package.json'); console.log(Object.keys(p.scripts||{}).join(','))\""
    }
  ],
  "verificationCommands": [
    "npm run cloud:agent-preflight",
    "git diff --check"
  ],
  "mutationDefaults": {
    "editFiles": "allowed",
    "runTests": "allowed",
    "commit": "allowed",
    "createIssue": "allowed",
    "createPullRequest": "confirm",
    "push": "confirm",
    "deployPreview": "confirm",
    "merge": "confirm",
    "destructive": "deny"
  },
  "notes": [
    "Pose Lab V2 is not old Pose Lab; do not import old runtime systems or debug bridges.",
    "Cloud worker jobs are diagnostic unless explicitly authorized to promote animation.",
    "Hosted visual review remains final acceptance; smoke/build checks are guardrails only.",
    "Generated cloud worker output should stay under generated/cloud-worker-jobs/<job-id>/outputs/."
  ]
}
