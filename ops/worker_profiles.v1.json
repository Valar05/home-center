{
  "schemaVersion": "home-center.worker-resource-contract.v1",
  "policy": {
    "scaleToZeroDefault": true,
    "singleArtifactConcurrency": 1,
    "maxVcpuWithoutBenchmark": 4,
    "maxForgeInstancesWithoutReview": 8,
    "promotionEvidence": [
      "same immutable input",
      "same acceptance checks",
      "baseline and candidate phase timings",
      "elapsed-time and estimated-cost comparison",
      "CPU and memory utilization or an explicit telemetry gap"
    ]
  },
  "profiles": {
    "control-plane": {
      "runtime": "cloud-run-service",
      "cpu": 1,
      "memory": "512Mi",
      "concurrency": 80,
      "minInstances": 0,
      "maxInstances": 20,
      "timeoutSeconds": 300,
      "nativeThreads": 1
    },
    "discord-interaction-control": {
      "runtime": "cloud-run-service",
      "cpu": 1,
      "memory": "512Mi",
      "concurrency": 80,
      "minInstances": 1,
      "maxInstances": 1,
      "timeoutSeconds": 300,
      "nativeThreads": 1,
      "billingGuard": "Deployment requires explicit owner approval for exactly one always-warm 512 MiB instance; the pilot is capped at one total instance so burst traffic cannot create additional instances."
    },
    "media-forge-light": {
      "runtime": "cloud-run-service",
      "cpu": 4,
      "memory": "4Gi",
      "concurrency": 1,
      "minInstances": 0,
      "maxInstances": 8,
      "timeoutSeconds": 1800,
      "nativeThreads": "available"
    },
    "media-forge-heavy": {
      "runtime": "cloud-run-service",
      "cpu": 4,
      "memory": "8Gi",
      "concurrency": 1,
      "minInstances": 0,
      "maxInstances": 4,
      "timeoutSeconds": 1800,
      "nativeThreads": "available"
    },
    "browser-session": {
      "runtime": "cloud-run-service",
      "cpu": 2,
      "memory": "2Gi",
      "concurrency": 1,
      "minInstances": 0,
      "maxInstances": 4,
      "timeoutSeconds": 900,
      "nativeThreads": 2
    }
  },
  "assignments": {
    "home-center-mcp": {
      "profile": "control-plane",
      "state": "guardrail",
      "reason": "Authentication, dispatch, registry, and status work must not inherit media-forge sizing."
    },
    "venice-discord-interactions": {
      "profile": "discord-interaction-control",
      "state": "bound",
      "serviceAccount": "venice-discord-runtime@home-center-dclar.iam.gserviceaccount.com",
      "reason": "Discord signature verification, consent-state transitions, immediate callbacks, and bounded single-message generation tasks share one narrow Firebase Functions release surface.",
      "deployment": {
        "path": "tools/deploy_venice_discord.sh",
        "kind": "firebase-functions",
        "requiredMarkers": [
          "worker_profile_contract.mjs shell venice-discord-interactions",
          "validate-resolved venice-discord-interactions",
          "verify-live venice-discord-interactions",
          "WORKER_SERVICE_ACCOUNT",
          "EXPECTED_PROJECT=\"home-center-dclar\"",
          "roles/datastore.user",
          "roles/cloudtasks.enqueuer",
          "DISCORD_PUBLIC_KEY",
          "OPENAI_API_KEY",
          "venice-discord-generation",
          "--only functions:veniceDiscordInteractions",
          "--approve-warm-cost"
        ],
        "forbiddenMarkers": [
          "VENICE_WORKER_CPU",
          "VENICE_WORKER_MEMORY",
          "VENICE_WORKER_CONCURRENCY",
          "VENICE_WORKER_MAX_INSTANCES",
          "DISCORD_BOT_TOKEN",
          "verify_venice_iam.mjs"
        ]
      }
    },
    "home-center-audio-render": {
      "profile": "media-forge-light",
      "state": "target",
      "promotionGate": "Move deterministic mixing and encoding behind a dedicated private service, preserve immutable speech stems, use native FFmpeg threads, and pass the same-stem benchmark before changing production routing."
    },
    "home-center-video-render": {
      "profile": "media-forge-heavy",
      "state": "target",
      "promotionGate": "Use native codec/render threads inside one artifact and scale independent shots or scenes across instances."
    },
    "home-center-browser-worker": {
      "profile": "browser-session",
      "state": "target",
      "promotionGate": "Prove one isolated browser session per instance and bounded session cleanup before cloud promotion."
    },
    "home-center-blender-workspace": {
      "profile": "media-forge-heavy",
      "state": "bound",
      "reason": "One deterministic Blender workspace recipe mutates or derives artifacts from one explicit immutable scene revision per instance.",
      "deployment": {
        "path": "tools/deploy_blender_workspace_worker.sh",
        "kind": "cloud-run-service",
        "resourceNameDefault": "home-center-blender",
        "requiredMarkers": [
          "worker_profile_contract.mjs\" shell home-center-blender-workspace",
          "validate-resolved home-center-blender-workspace",
          "verify-live home-center-blender-workspace",
          "--concurrency=\"$WORKER_CONCURRENCY\""
        ],
        "forbiddenMarkers": [
          "BLENDER_WORKER_CPU",
          "BLENDER_WORKER_MEMORY",
          "BLENDER_WORKER_CONCURRENCY",
          "BLENDER_WORKER_MAX_INSTANCES"
        ]
      }
    }
  },
  "deploymentDiscovery": {
    "roots": [
      "tools",
      ".github/workflows"
    ],
    "extensions": [
      ".sh",
      ".yml",
      ".yaml"
    ],
    "exemptions": {
      "tools/deploy_dionysus_cloud.sh": {
        "kind": "cloud-run-service",
        "reason": "Dionysus is a short interactive novelty service, not a long-work worker."
      },
      "tools/deploy_functions_termux.sh": {
        "kind": "cloud-functions",
        "reason": "This deploys the MCP control plane; its guardrail is the home-center-mcp assignment."
      },
      "tools/setup_google_tools_gateway.sh": {
        "kind": "firebase-functions",
        "reason": "This is a one-time control-plane bootstrap wrapper, not a worker deployment."
      },
      "tools/deploy_firebase.sh": {
        "kind": "firebase-functions",
        "reason": "This is the legacy mixed Firebase control/data-plane deployment wrapper, not a worker deployment."
      }
    }
  }
}
